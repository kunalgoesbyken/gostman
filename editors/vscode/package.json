{
  "name": "gostman",
  "displayName": "Gostman",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "Gostman",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/kunalgoesbyken/gostman.git", "directory": "editors/vscode" },
  "homepage": "https://gostman.com",
  "bugs": { "url": "https://github.com/kunalgoesbyken/gostman/issues" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Testing", "Other"],
  "keywords": ["api", "rest", "graphql", "grpc", "websocket", "http client", "postman", "bruno", "mcp"],
  "main": "./extension.js",
  "extensionKind": ["workspace"],
  "l10n": "./l10n",
  "activationEvents": ["workspaceContains:**/gostman.yaml"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "%capabilities.untrustedWorkspaces%" },
    "virtualWorkspaces": { "supported": false, "description": "%capabilities.virtualWorkspaces%" }
  },
  "contributes": {
    "commands": [
      { "command": "gostman.run", "title": "%command.run%" },
      { "command": "gostman.runFolder", "title": "%command.runFolder%" },
      { "command": "gostman.send", "title": "%command.send%" },
      { "command": "gostman.sendFile", "title": "%command.sendFile%" },
      { "command": "gostman.selectEnvironment", "title": "%command.selectEnvironment%" },
      { "command": "gostman.flow", "title": "%command.flow%" },
      { "command": "gostman.lint", "title": "%command.lint%" },
      { "command": "gostman.scan", "title": "%command.scan%" },
      { "command": "gostman.init", "title": "%command.init%" },
      { "command": "gostman.docs", "title": "%command.docs%" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "gostman.sendFile", "when": "resourceExtname =~ /\\.ya?ml$/" }
      ],
      "explorer/context": [
        { "command": "gostman.lint", "when": "resourceExtname =~ /\\.(ya?ml|json)$/", "group": "gostman" }
      ]
    },
    "configuration": {
      "title": "Gostman",
      "properties": {
        "gostman.path": {
          "type": "string",
          "default": "gostman",
          "markdownDescription": "%config.path%",
          "scope": "machine"
        },
        "gostman.environment": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.environment%"
        }
      }
    }
  },
  "scripts": {
    "l10n:export": "vscode-l10n-dev export --outDir l10n \"*.js\"",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": { "@vscode/l10n-dev": "^0.0.35", "@vscode/vsce": "^3.0.0" }
}
