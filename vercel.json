{
    "framework": "vite",
    "buildCommand": "cd gostman-gui/frontend && npm install && npm run build:web",
    "outputDirectory": "gostman-gui/frontend/dist-web",
    "functions": {
        "api/proxy.go": {
            "maxDuration": 60
        }
    },
    "headers": [
        {
            "source": "/assets/sandbox.worker.(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'none'; script-src 'unsafe-eval'"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/|assets/).*)",
            "destination": "/index.html"
        }
    ]
}
