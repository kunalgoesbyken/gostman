{
    "framework": "vite",
    "buildCommand": "cd gostman-gui/frontend && npm install && npm run build:web",
    "outputDirectory": "gostman-gui/frontend/dist-web",
    "functions": {
        "api/proxy.go": {
            "maxDuration": 60
        }
    },
    "headers": [
        {
            "source": "/sw.js",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache" },
                { "key": "Service-Worker-Allowed", "value": "/" }
            ]
        },
        {
            "source": "/manifest.webmanifest",
            "headers": [
                { "key": "Content-Type", "value": "application/manifest+json" }
            ]
        },
        {
            "source": "/(assets|docs-images)/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/assets/sandbox.worker.(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'none'; script-src 'unsafe-eval'"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/oauth-callback",
            "destination": "/index.html"
        }
    ]
}
